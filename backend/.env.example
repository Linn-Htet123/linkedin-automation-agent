# ============================================
# LinkedIn Automation Agent - Environment Config
# ============================================

# Anthropic Claude API Key (required)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# LinkedIn Credentials (for browser automation login)
LINKEDIN_EMAIL=your-email@example.com
LINKEDIN_PASSWORD=your-password-here

# Server Configuration
PORT=3001
NODE_ENV=development

# Browser Automation Settings
HEADLESS=false
BROWSER_SLOW_MO=50

# Session Storage Path (for persistent login)
SESSION_DIR=./sessions

# Debug Mode — saves screenshot + HTML dump at every automation step
# Set to "true" to enable (files saved to backend/debug/)
DEBUG=false
